# Copia este archivo a ".env" (mismo directorio) y completa los valores.
# El archivo ".env" NUNCA se sube al repositorio (ver .gitignore).

# --- Firebase (Firestore) ---
# Consola: https://console.firebase.google.com > Proyecto > Configuracion
# del proyecto > "Tus apps" > app web > "Config"
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- PIN de administrador ---
# Se pide para entrar a /admin/datos y /admin/puntajes
VITE_ADMIN_PIN=1234

# --- EmailJS (aviso por email al admin cuando se carga un puntaje) ---
# Cuenta: https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
