rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /escuelas/{id} {
      allow read, write: if true;
    }
    match /puestas/{id} {
      allow read, write: if true;
    }
    match /puntajes/{id} {
      allow read: if true;
      allow create, update: if true; // el jurado puede corregir un puntaje ya enviado
      allow delete: if false;
    }
  }
}
